# Copy to backend/.env for local development. Every setting is optional except in production.
WRITEMIND_ENVIRONMENT=development
WRITEMIND_DATABASE_URL=postgresql+asyncpg://writemind:writemind@localhost:5432/writemind
WRITEMIND_LANGUAGETOOL_URL=http://localhost:8081

# Required in production: 32+ random characters, e.g. `python -c "import secrets; print(secrets.token_urlsafe(48))"`
# WRITEMIND_JWT_SECRET=

# AI contextual corrections and rewrites (Claude). Without a key the engine runs LanguageTool + WriteMind rules,
# and rewrites use the offline style engine.
# ANTHROPIC_API_KEY=
# WRITEMIND_AI_MODEL=claude-opus-5-5
# WRITEMIND_AI_EFFORT=low
# WRITEMIND_AI_TIMEOUT_SECONDS=8

# Allow-list your published extension ID in production instead of any chrome-extension:// origin.
# WRITEMIND_CORS_ORIGIN_REGEX=^chrome-extension://abcdefghijklmnopabcdefghijklmnop$

# Set to true only when running behind a trusted reverse proxy that sets X-Forwarded-For.
# WRITEMIND_TRUST_PROXY_HEADERS=false
