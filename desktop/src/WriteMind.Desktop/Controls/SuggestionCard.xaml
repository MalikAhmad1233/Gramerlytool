<UserControl x:Class="WriteMind.Desktop.Controls.SuggestionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource CardBorder}" Width="320">
        <StackPanel>
            <DockPanel LastChildFill="False">
                <Ellipse x:Name="SeverityDot" Width="8" Height="8" Fill="{StaticResource ErrorBrush}" VerticalAlignment="Center" Margin="0,0,6,0" />
                <TextBlock x:Name="CategoryText" Style="{StaticResource ChipLabel}" VerticalAlignment="Center" Text="GRAMMAR" />
                <Border x:Name="AiTag" Background="{StaticResource BrandGradient}" CornerRadius="6" Padding="6,1" Margin="8,0,0,0"
                        VerticalAlignment="Center" Visibility="Collapsed">
                    <TextBlock Text="AI" Foreground="White" FontSize="10" FontWeight="Bold" />
                </Border>
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="×"
                        ToolTip="Close" Click="OnClose" />
            </DockPanel>
            <TextBlock x:Name="TitleText" Style="{StaticResource TitleText}" Margin="0,6,0,2" />
            <TextBlock x:Name="MessageText" Style="{StaticResource MutedText}" Margin="0,0,0,10" />
            <WrapPanel x:Name="Replacements" Margin="0,0,0,4" />
            <TextBlock x:Name="CannotEditText" Style="{StaticResource MutedText}" Visibility="Collapsed" Margin="0,0,0,8"
                       Text="This part of the text can't be edited automatically. Copy the correction instead." />
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="0,6,0,0">
                <WrapPanel>
                    <Button Style="{StaticResource GhostButton}" Content="Ignore" Click="OnIgnore" />
                    <Button x:Name="DictionaryButton" Style="{StaticResource GhostButton}" Content="Add to dictionary" Click="OnAddWord" />
                    <Button Style="{StaticResource GhostButton}" Content="Turn off this rule" Click="OnDisableRule" />
                </WrapPanel>
            </Border>
        </StackPanel>
    </Border>
</UserControl>
