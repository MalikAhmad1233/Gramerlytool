<Window x:Class="WriteMind.Desktop.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Welcome to WriteMind AI" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        Background="{StaticResource SoftBrush}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" Icon="/Assets/writemind.png">
    <StackPanel>
        <!-- Hero -->
        <Border Background="{StaticResource BrandGradient}" Padding="28,26,28,30">
            <StackPanel HorizontalAlignment="Center">
                <Image Source="/Assets/writemind.png" Width="64" Height="64" HorizontalAlignment="Center" />
                <TextBlock Text="Welcome to WriteMind AI" FontSize="24" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" Margin="0,12,0,4" />
                <TextBlock Text="Detect Instantly. Suggest Intelligently. Let Users Decide." Foreground="#E0E7FF"
                           HorizontalAlignment="Center" />
                <Border Background="#29FFFFFF" CornerRadius="12" Padding="12,4" Margin="0,12,0,0" HorizontalAlignment="Center">
                    <TextBlock Text="Ready to use · no account needed · works offline" Foreground="White" FontWeight="SemiBold" FontSize="12" />
                </Border>
            </StackPanel>
        </Border>

        <StackPanel Margin="24,18,24,20">
            <!-- 1. Language -->
            <Border Style="{StaticResource CardBorder}" Padding="18,14">
                <StackPanel>
                    <TextBlock Text="1 · Which English do you write?" Style="{StaticResource TitleText}" />
                    <TextBlock Style="{StaticResource MutedText}" Margin="0,2,0,10" TextWrapping="Wrap"
                               Text="WriteMind follows the spelling you choose. You can change it any time in Settings." />
                    <UniformGrid Columns="2">
                        <ToggleButton x:Name="AmericanButton" Click="OnAmerican" Margin="0,0,6,0" Cursor="Hand" Padding="12,10"
                                      HorizontalContentAlignment="Left" Background="White" BorderBrush="{StaticResource LineBrush}">
                            <StackPanel>
                                <TextBlock Text="American English" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="color · organize · center" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </ToggleButton>
                        <ToggleButton x:Name="BritishButton" Click="OnBritish" Margin="6,0,0,0" Cursor="Hand" Padding="12,10"
                                      HorizontalContentAlignment="Left" Background="White" BorderBrush="{StaticResource LineBrush}">
                            <StackPanel>
                                <TextBlock Text="British English" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Text="colour · organise · centre" Style="{StaticResource MutedText}" />
                            </StackPanel>
                        </ToggleButton>
                    </UniformGrid>
                </StackPanel>
            </Border>

            <!-- 2. How it works -->
            <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="2 · How it works" Style="{StaticResource TitleText}" />
                    <UniformGrid Columns="3" Margin="0,10,0,0">
                        <Border Background="{StaticResource SoftBrush}" CornerRadius="10" Padding="12" Margin="0,0,6,0">
                            <StackPanel>
                                <TextBlock Text="Write as usual" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="In Word, Outlook, Notepad, WhatsApp, Teams and more. Mistakes get underlined." />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SoftBrush}" CornerRadius="10" Padding="12" Margin="3,0">
                            <StackPanel>
                                <TextBlock Text="Click to see the fix" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Click an underline, or press Ctrl+Alt+W for the writing assistant." />
                            </StackPanel>
                        </Border>
                        <Border Background="{StaticResource SoftBrush}" CornerRadius="10" Padding="12" Margin="6,0,0,0">
                            <StackPanel>
                                <TextBlock Text="You stay in control" FontWeight="SemiBold" Foreground="{StaticResource FgBrush}" />
                                <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Text="Nothing changes until you click Accept. Passwords are never read." />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                    <TextBlock Style="{StaticResource MutedText}" TextWrapping="Wrap" Margin="0,10,0,0"
                               Text="WriteMind lives in the system tray (bottom-right, near the clock). Right-click its icon for the editor, settings, or to pause." />
                </StackPanel>
            </Border>

            <!-- 3. Startup -->
            <Border Style="{StaticResource CardBorder}" Padding="18,14" Margin="0,12,0,0">
                <StackPanel>
                    <TextBlock Text="3 · Always ready" Style="{StaticResource TitleText}" />
                    <CheckBox x:Name="StartupCheck" Margin="0,8,0,0" Content="Start WriteMind automatically when I sign in to Windows" />
                </StackPanel>
            </Border>

            <DockPanel Margin="0,16,0,0" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" VerticalAlignment="Center" Style="{StaticResource MutedText}" FontSize="12"
                           Text="🔒 Your text is checked on this PC." />
                <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="Start writing" Click="OnDone" IsDefault="True" Margin="8,0,0,0" />
                <Button DockPanel.Dock="Right" Style="{StaticResource SecondaryButton}" Content="Try it in the editor" Click="OnTryEditor" />
            </DockPanel>
        </StackPanel>
    </StackPanel>
</Window>
