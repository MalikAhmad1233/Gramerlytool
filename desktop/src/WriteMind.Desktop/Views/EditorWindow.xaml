<Window x:Class="WriteMind.Desktop.Views.EditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WriteMind.Desktop.Controls"
        Title="WriteMind Editor" Width="1180" Height="760" MinWidth="760" MinHeight="480"
        Background="{StaticResource SoftBrush}" FontFamily="{StaticResource UiFont}"
        WindowStartupLocation="CenterScreen" Icon="/Assets/writemind.png">
    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="380" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorder}" Padding="0">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,10">
                    <DockPanel>
                        <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                            <Image Source="/Assets/writemind.png" Width="26" Height="26" Margin="0,0,10,0" />
                            <TextBlock Text="WriteMind Editor" Style="{StaticResource TitleText}" FontSize="15" VerticalAlignment="Center" />
                        </StackPanel>
                        <WrapPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Button Style="{StaticResource GhostButton}" Content="New" Click="OnNew" Margin="0" />
                            <Button Style="{StaticResource GhostButton}" Content="Open…" Click="OnOpen" Margin="0" />
                            <Button Style="{StaticResource GhostButton}" Content="Save as…" Click="OnSave" Margin="0" />
                            <Button Style="{StaticResource SecondaryButton}" Content="Copy all" Click="OnCopyAll" Margin="8,0,0,0" />
                        </WrapPanel>
                    </DockPanel>
                </Border>
                <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0" Padding="14,6">
                    <DockPanel>
                        <TextBlock x:Name="StatusText" Style="{StaticResource MutedText}" FontSize="12" Text="Start typing — suggestions appear as you pause." />
                    </DockPanel>
                </Border>
                <TextBox x:Name="Editor" BorderThickness="0" Padding="22,18" FontSize="16" FontFamily="Segoe UI"
                         AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="False" Foreground="{StaticResource FgBrush}" />
            </DockPanel>
        </Border>

        <Border Grid.Column="2" Style="{StaticResource CardBorder}" Padding="0" ClipToBounds="True">
            <controls:AssistantPanel x:Name="Panel" ShowCloseButton="False" />
        </Border>

        <Popup x:Name="CardPopup" StaysOpen="False" AllowsTransparency="True" Placement="MousePoint" PopupAnimation="Fade">
            <controls:SuggestionCard x:Name="Card" Margin="12" Effect="{StaticResource CardShadow}" />
        </Popup>
    </Grid>
</Window>
