 "rules": [
  {
   "id": "WM_COULD_OF",
   "category": "grammar",
   "severity": "error",
   "title": "Wrong verb form",
   "message": "Use “have” (not “of”) after “{1}”.",
   "pattern": "\\b(could|should|would|must|might)\\s+of\\b",
   "flags": "i",
   "replace": [
    "{1} have"
   ],
   "confidence": 0.92,
   "group": 0
  },
  {
   "id": "WM_ALOT",
   "category": "spelling",
   "severity": "error",
   "title": "Spelling mistake",
   "message": "“A lot” is written as two words.",
   "pattern": "\\b(alot)\\b",
   "flags": "i",
   "group": 1,
   "replace": [
    "a lot"
   ],
   "confidence": 0.95
  },
  {
   "id": "WM_MISSING_APOSTROPHE",
   "category": "spelling",
   "severity": "error",
   "title": "Missing apostrophe",
   "message": "This contraction needs an apostrophe: “{=}”.",
   "pattern": "(?<![\\w'’])(shouldnt|couldnt|wouldnt|doesnt|werent|havent|mustnt|neednt|theyre|theyve|theres|didnt|arent|wasnt|hasnt|hadnt|youre|youve|youll|thats|whats|heres|doesn|dont|cant|isnt|weve|itll|shes|didn|ive|im)(?![\\w'’])",
   "flags": "i",
   "group": 1,
   "map": "apostrophe",
   "skipAllCaps": true,
   "confidence": 0.9
  },
  {
   "id": "WM_LETS",
   "category": "grammar",
   "severity": "error",
   "title": "Missing apostrophe",
   "message": "“Let's” (let us) needs an apostrophe here.",
   "pattern": "\\b(Lets)\\s+(?=(?:go|meet|do|make|start|try|see|talk|get|have|take|discuss|plan|catch|chat|grab|keep|move|work|be|finish|hope)\\b)",
   "group": 1,
   "replace": [
    "Let's"
   ],
   "confidence": 0.9,
   "flags": ""
  },
  {
   "id": "WM_ITS_IT_IS",
   "category": "grammar",
   "severity": "error",
   "title": "Commonly confused words",
   "message": "Use “it's” (it is) here — “its” is possessive.",
   "pattern": "\\b(its)\\s+(?=(?:a|an|the|not|been|going|getting|ok|okay|about|just|nice|great|good|fine|true|important|possible|hard|easy|late|early|my|your|our|done|gonna|raining|cold|hot|fun|here|there|me)\\b)",
   "flags": "i",
   "group": 1,
   "replace": [
    "it's"
   ],
   "confidence": 0.88
  },
  {
   "id": "WM_ITS_POSSESSIVE",
   "category": "grammar",
   "severity": "error",
   "title": "Commonly confused words",
   "message": "Use the possessive “its” (no apostrophe) here.",
   "pattern": "\\b(?:of|on|in|with|from|for|by|at|into|finished|lost|did|has|reached|changed|made|took|completed|improved|updated|kept|shared|reduced|increased|lose|change|improve|update|keep|share|reduce|increase|finish|complete)\\s+(it['’]s)\\s+(?!(?:a|an|the|not|been|going|getting|only|just|also|very|really|so|too|time|about|all|still|always|never)\\b)(?=[a-z]+\\b)",
   "flags": "i",
   "group": 1,
   "replace": [
    "its"
   ],
   "confidence": 0.85
  },
  {
   "id": "WM_YOUR_WELCOME",
   "category": "grammar",
   "severity": "error",
   "title": "Commonly confused words",
   "message": "Use “you're” (you are) here: “you're welcome”.",
   "pattern": "\\b(your)(?=\\s+welcome\\b\\s*(?:[.!,]|to\\b|$))",
   "flags": "i",
   "group": 1,
   "replace": [
    "you're"
   ],
   "confidence": 0.9
  },
  {
   "id": "WM_YOURE",
   "category": "grammar",
   "severity": "error",
   "title": "Commonly confused words",
   "message": "Use “you're” (you are) here.",
   "pattern": "\\b(your)(?=\\s+(?:the\\s+best|going\\s+to|not\\s+going|being\\s+(?:silly|serious|ridiculous|so|too|very)))",
   "flags": "i",
