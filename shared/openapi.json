  "components": {
    "schemas": {
      "Category": {
        "type": "string",
        "enum": [
          "grammar",
          "spelling",
          "punctuation",
          "style",
          "clarity"
        ],
        "title": "Category"
      },
      "CheckRequest": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "language": {
            "type": "string",
            "enum": [
              "en-US",
              "en-GB",
              "en-CA",
              "en-AU",
              "en-NZ",
              "en-ZA",
              "de-DE",
              "fr",
              "es",
              "it",
              "nl",
              "pt-PT",
              "pt-BR"
            ],
            "title": "Language",
            "default": "en-US"
          },
          "style": {
            "$ref": "#/components/schemas/Style",
            "default": "neutral"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "full"
            ],
            "title": "Mode",
            "default": "fast"
          },
          "client": {
            "$ref": "#/components/schemas/ClientContext"
          },
          "categories": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/Category"
                },
                "type": "array",
                "maxItems": 10
              },
              {
                "type": "null"
              }
            ],
            "title": "Categories"
          },
          "dictionary": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 2000,
            "title": "Dictionary"
          },
          "disabled_rules": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 500,
            "title": "Disabled Rules"
          },
          "ai": {
            "type": "boolean",
            "title": "Ai",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "text"
        ],
        "title": "CheckRequest"
      },
      "CheckResponse": {
        "properties": {
          "text_hash": {
            "type": "string",
            "title": "Text Hash"
          },
          "language": {
            "type": "string",
            "title": "Language"
          },
          "style": {
            "$ref": "#/components/schemas/Style"
          },
          "mode": {
            "type": "string",
            "enum": [
              "fast",
              "full"
            ],
            "title": "Mode"
          },
          "suggestions": {
            "items": {
              "$ref": "#/components/schemas/Suggestion"
            },
            "type": "array",
            "title": "Suggestions"
          },
          "stats": {
            "$ref": "#/components/schemas/CheckStats"
          },
          "engine": {
            "$ref": "#/components/schemas/EngineInfo"
          }
        },
        "type": "object",
        "required": [
          "text_hash",
          "language",
          "style",
          "mode",
          "suggestions",
          "stats",
          "engine"
        ],
        "title": "CheckResponse"
      },
      "CheckStats": {
        "properties": {
          "characters": {
            "type": "integer",
            "title": "Characters"
          },
          "words": {
            "type": "integer",
            "title": "Words"
          },
          "sentences": {
            "type": "integer",
            "title": "Sentences"
          },
          "issues": {
            "additionalProperties": {
              "type": "integer"
            },
            "type": "object",
            "title": "Issues"
          },
          "score": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Score"
          }
        },
        "type": "object",
        "required": [
          "characters",
          "words",
          "sentences",
          "issues",
          "score"
        ],
        "title": "CheckStats"
      },
      "ClientContext": {
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/ClientKind",
            "default": "api"
          },
          "app": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 40,
                "pattern": "^[a-z0-9._-]+$"
              },
              {
                "type": "null"
              }
            ],
            "title": "App"
          }
        },
        "type": "object",
        "title": "ClientContext"
      },
      "ClientKind": {
        "type": "string",
        "enum": [
          "chrome-extension",
          "windows-desktop",
          "web",
          "api"
        ],
        "title": "ClientKind"
      },
      "DeleteAccountRequest": {
        "properties": {
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          }
        },
        "type": "object",
        "required": [
          "password"
        ],
        "title": "DeleteAccountRequest"
      },
      "DictionaryOut": {
        "properties": {
          "words": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Words"
          },
          "count": {
            "type": "integer",
            "title": "Count"
          },
          "limit": {
            "type": "integer",
            "title": "Limit"
          }
        },
        "type": "object",
        "required": [
          "words",
          "count",
          "limit"
        ],
        "title": "DictionaryOut"
      },
      "DictionaryWord": {
        "properties": {
          "word": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Word"
          }
        },
        "type": "object",
        "required": [
          "word"
        ],
        "title": "DictionaryWord"
      },
      "EngineInfo": {
        "properties": {
          "languagetool": {
            "type": "string",
            "enum": [
              "ok",
              "error"
            ],
            "title": "Languagetool"
          },
          "ai": {
            "type": "string",
            "enum": [
              "used",
              "skipped",
              "disabled",
              "unavailable",
              "error"
            ],
            "title": "Ai"
          },
          "paragraphs_checked": {
            "type": "integer",
            "title": "Paragraphs Checked"
          },
          "paragraphs_cached": {
            "type": "integer",
            "title": "Paragraphs Cached"
          },
          "latency_ms": {
            "type": "number",
            "title": "Latency Ms"
          }
        },
        "type": "object",
        "required": [
          "languagetool",
          "ai",
          "paragraphs_checked",
          "paragraphs_cached",
          "latency_ms"
        ],
        "title": "EngineInfo"
      },
      "FeedbackBatch": {
        "properties": {
          "client": {
            "$ref": "#/components/schemas/ClientKind"
          },
          "events": {
            "items": {
              "$ref": "#/components/schemas/FeedbackEvent"
            },
            "type": "array",
            "maxItems": 50,
            "minItems": 1,
            "title": "Events"
          }
        },
        "type": "object",
        "required": [
          "client",
          "events"
        ],
        "title": "FeedbackBatch"
      },
      "FeedbackEvent": {
        "properties": {
          "rule_id": {
            "type": "string",
            "maxLength": 120,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9_.:\\-]+$",
            "title": "Rule Id"
          },
          "category": {
            "$ref": "#/components/schemas/Category"
          },
          "source": {
            "$ref": "#/components/schemas/Source"
          },
          "action": {
            "type": "string",
            "enum": [
              "accepted",
              "ignored",
              "rule_disabled",
              "added_to_dictionary"
            ],
            "title": "Action"
          }
        },
        "type": "object",
        "required": [
          "rule_id",
          "category",
          "source",
          "action"
        ],
        "title": "FeedbackEvent"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LoginRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 1,
            "title": "Password"
          },
          "client": {
            "$ref": "#/components/schemas/ClientKind",
            "default": "api"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "LoginRequest"
      },
      "RefreshRequest": {
        "properties": {
          "refresh_token": {
            "type": "string",
            "maxLength": 200,
            "minLength": 20,
            "title": "Refresh Token"
          }
        },
        "type": "object",
        "required": [
          "refresh_token"
        ],
        "title": "RefreshRequest"
      },
      "RegisterRequest": {
        "properties": {
          "email": {
            "type": "string",
            "format": "email",
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 128,
            "minLength": 8,
            "title": "Password"
          },
          "display_name": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 120
              },
              {
                "type": "null"
              }
            ],
            "title": "Display Name"
          },
          "client": {
            "$ref": "#/components/schemas/ClientKind",
            "default": "api"
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "RegisterRequest"
      },
      "RewriteAlternative": {
        "properties": {
          "text": {
            "type": "string",
            "title": "Text"
          },
          "source": {
            "type": "string",
            "enum": [
              "ai",
              "rules"
            ],
            "title": "Source"
          },
